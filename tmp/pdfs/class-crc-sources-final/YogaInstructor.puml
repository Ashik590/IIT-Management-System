@startuml
title Ref: Table 12\nName: YogaInstructor

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 140
skinparam ranksep 150
skinparam padding 20
skinparam dpi 150

skinparam rectangle {
    BackgroundColor #DCEEFF
    BorderColor #3973AC
    FontColor #16324F
    FontStyle bold
    FontSize 14
    RoundCorner 14
}

skinparam ArrowColor #526D82
skinparam ArrowFontColor #263746
skinparam ArrowFontSize 12

' Top
rectangle "UserAccount" as UserAccount

' Centre
rectangle "YogaInstructor" as YogaInstructor #72B6E8

' Bottom
rectangle "YogaSession" as YogaSession
rectangle "YogaContent" as YogaContent

' Layout constraints
UserAccount -[hidden]down- YogaInstructor
YogaSession -[hidden]right- YogaContent
YogaInstructor -[hidden]down- YogaSession
YogaInstructor -[hidden]down- YogaContent

' CRC collaborations
UserAccount -down- YogaInstructor : Authenticates and accesses\ninstructor functions

YogaInstructor -down- YogaSession : Receives assignments and views\nassigned sessions

YogaInstructor -down- YogaContent : Creates, updates and submits\nyoga content

caption Fig crc.3: YogaInstructor
@enduml
