@startuml
title Ref: Table 26\nName: YogaContent

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 140
skinparam ranksep 150
skinparam padding 20
skinparam dpi 150

skinparam rectangle {
    BackgroundColor #DCEEFF
    BorderColor #3973AC
    FontColor #16324F
    FontStyle bold
    FontSize 14
    RoundCorner 14
}

skinparam ArrowColor #526D82
skinparam ArrowFontColor #263746
skinparam ArrowFontSize 12

' Top
rectangle "YogaInstructor" as YogaInstructor

' Centre
rectangle "YogaContent" as YogaContent #72B6E8

' Bottom
rectangle "VajraAssistant" as VajraAssistant
rectangle "Member" as Member

' Layout constraints
YogaInstructor -[hidden]down- YogaContent
VajraAssistant -[hidden]right- Member
YogaContent -[hidden]down- VajraAssistant
YogaContent -[hidden]down- Member

' CRC collaborations
YogaInstructor -down- YogaContent : Receives content creation,\nupdates and approval

YogaContent -down- VajraAssistant : Supplies approved content for\nsearch and answers

YogaContent -down- Member : Provides approved content for\nviewing and search

caption Fig crc.17: YogaContent
@enduml
