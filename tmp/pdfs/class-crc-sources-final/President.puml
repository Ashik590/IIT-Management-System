@startuml
title Ref: Table 14\nName: President

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 140
skinparam ranksep 150
skinparam padding 20
skinparam dpi 150

skinparam rectangle {
    BackgroundColor #DCEEFF
    BorderColor #3973AC
    FontColor #16324F
    FontStyle bold
    FontSize 14
    RoundCorner 14
}

skinparam ArrowColor #526D82
skinparam ArrowFontColor #263746
skinparam ArrowFontSize 12

' Top
rectangle "ExecutiveCommitteeMember" as ExecutiveCommitteeMember

' Middle
rectangle "FinancialManagement" as FinancialManagement
rectangle "President" as President #72B6E8
rectangle "Activity" as Activity

' Bottom
rectangle "Secretary" as Secretary

' Layout constraints
ExecutiveCommitteeMember -[hidden]down- President

FinancialManagement -[hidden]right- President
President -[hidden]right- Activity

President -[hidden]down- Secretary

' CRC collaborations
ExecutiveCommitteeMember -down- President : Provides common committee\naccess and operations

FinancialManagement -right- President : Reviews financial reports

President -right- Activity : Reviews attendance and monitors\nactivities

President -down- Secretary : Coordinates supervision and\ncommittee work

caption Fig crc.5: President
@enduml
