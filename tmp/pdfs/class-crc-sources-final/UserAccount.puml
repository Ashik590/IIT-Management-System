@startuml
title Ref: Table 10\nName: UserAccount

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 140
skinparam ranksep 150
skinparam padding 20
skinparam dpi 150

skinparam rectangle {
    BackgroundColor #DCEEFF
    BorderColor #3973AC
    FontColor #16324F
    FontStyle bold
    FontSize 14
    RoundCorner 14
}

skinparam ArrowColor #526D82
skinparam ArrowFontColor #263746
skinparam ArrowFontSize 12

' Top
rectangle "Member" as Member

' Centre
rectangle "UserAccount" as UserAccount #72B6E8

' Bottom
rectangle "YogaInstructor" as YogaInstructor
rectangle "ExecutiveCommitteeMember" as ExecutiveCommitteeMember

' Layout constraints
Member -[hidden]down- UserAccount
YogaInstructor -[hidden]right- ExecutiveCommitteeMember
UserAccount -[hidden]down- YogaInstructor
UserAccount -[hidden]down- ExecutiveCommitteeMember

' CRC collaborations
Member -down- UserAccount : Authenticates and provides\nmember access

UserAccount -down- YogaInstructor : Authenticates and provides\ninstructor access

UserAccount -down- ExecutiveCommitteeMember : Authenticates and controls\ncommittee access

caption Fig crc.1: UserAccount
@enduml
