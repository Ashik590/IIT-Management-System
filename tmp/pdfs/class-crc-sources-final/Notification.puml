@startuml
title Ref: Table 28\nName: Notification

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 140
skinparam ranksep 150
skinparam padding 20
skinparam dpi 150

skinparam rectangle {
    BackgroundColor #DCEEFF
    BorderColor #3973AC
    FontColor #16324F
    FontStyle bold
    FontSize 14
    RoundCorner 14
}

skinparam ArrowColor #526D82
skinparam ArrowFontColor #263746
skinparam ArrowFontSize 12

' Top row
rectangle "Member" as Member
rectangle "Activity" as Activity

' Centre
rectangle "Notification" as Notification #72B6E8

' Bottom row
rectangle "YogaSession" as YogaSession
rectangle "Event" as Event

' Layout constraints
Member -[hidden]right- Activity
YogaSession -[hidden]right- Event

Member -[hidden]down- Notification
Activity -[hidden]down- Notification

Notification -[hidden]down- YogaSession
Notification -[hidden]down- Event

' CRC collaborations
Member -down- Notification : Provides recipient contact details and\nreceives attendance and event messages

Activity -down- Notification : Provides attendance context for\nmilestone messages

Notification -down- YogaSession : Sends an attendance message after\neach member session check-in

Notification -down- Event : Announces new events to members and\nconfirms completed registrations

caption Fig crc.19: Notification
@enduml
