@startuml
title Ref: Table 24\nName: PaymentGateway

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 140
skinparam ranksep 150
skinparam padding 20
skinparam dpi 150

skinparam rectangle {
    BackgroundColor #DCEEFF
    BorderColor #3973AC
    FontColor #16324F
    FontStyle bold
    FontSize 14
    RoundCorner 14
}

skinparam ArrowColor #526D82
skinparam ArrowFontColor #263746
skinparam ArrowFontSize 12

' Top
rectangle "FinancialManagement" as FinancialManagement

' Centre
rectangle "PaymentGateway" as PaymentGateway #72B6E8

' Bottom
rectangle "Member" as Member

' Layout constraints
FinancialManagement -[hidden]down- PaymentGateway
PaymentGateway -[hidden]down- Member

' CRC collaborations
FinancialManagement -down- PaymentGateway : Returns payment processing and\nverification results

PaymentGateway -down- Member : Accepts payment requests and\nreturns confirmation

caption Fig crc.15: PaymentGateway
@enduml
