@startuml
title Ref: Table 11\nName: Member

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 140
skinparam ranksep 150
skinparam padding 20
skinparam dpi 150

skinparam rectangle {
    BackgroundColor #DCEEFF
    BorderColor #3973AC
    FontColor #16324F
    FontStyle bold
    FontSize 14
    RoundCorner 14
}

skinparam ArrowColor #526D82
skinparam ArrowFontColor #263746
skinparam ArrowFontSize 12

' Top
rectangle "UserAccount" as UserAccount
rectangle "ExecutiveCommitteeMember" as ExecutiveCommitteeMember

' Middle
rectangle "Activity" as Activity
rectangle "Member" as Member #72B6E8
rectangle "Event" as Event

' Bottom
rectangle "FinancialManagement" as FinancialManagement
rectangle "YogaContent" as YogaContent

' Layout constraints
UserAccount -[hidden]right- ExecutiveCommitteeMember
Activity -[hidden]right- Member
Member -[hidden]right- Event
FinancialManagement -[hidden]right- YogaContent

UserAccount -[hidden]down- Activity
Activity -[hidden]down- FinancialManagement

ExecutiveCommitteeMember -[hidden]down- Event
Event -[hidden]down- YogaContent

' CRC collaborations
UserAccount -down- Member : Authenticates and accesses the\nmember account

ExecutiveCommitteeMember -down- Member : Verifies member information or\ndismisses an incorrect application

Activity -right- Member : Views activities, participation and\nattendance history

Member -right- Event : Registers for events

Member -down- FinancialManagement : Makes payments or donations and\nviews history

Member -down- YogaContent : Views approved yoga content

caption Fig crc.2: Member
@enduml
