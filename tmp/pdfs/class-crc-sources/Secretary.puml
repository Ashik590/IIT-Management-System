@startuml
title Ref: Table 15\nName: Secretary

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 140
skinparam ranksep 150
skinparam padding 20
skinparam dpi 150

skinparam rectangle {
    BackgroundColor #DCEEFF
    BorderColor #3973AC
    FontColor #16324F
    FontStyle bold
    FontSize 14
    RoundCorner 14
}

skinparam ArrowColor #526D82
skinparam ArrowFontColor #263746
skinparam ArrowFontSize 12

' Top
rectangle "ExecutiveCommitteeMember" as ExecutiveCommitteeMember

' Centre
rectangle "Secretary" as Secretary #72B6E8

' Bottom
rectangle "President" as President
rectangle "Activity" as Activity

' Layout constraints
ExecutiveCommitteeMember -[hidden]down- Secretary
President -[hidden]right- Activity
Secretary -[hidden]down- President
Secretary -[hidden]down- Activity

' CRC collaborations
ExecutiveCommitteeMember -down- Secretary : Provides common committee\naccess and operations

Secretary -down- President : Coordinates supervision,\nrecords and reporting

Secretary -down- Activity : Manages schedules and\nattendance summaries

caption Fig crc.6: Secretary
@enduml
