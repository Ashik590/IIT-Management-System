@startuml
title Ref: Table 20\nName: Activity

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 140
skinparam ranksep 150
skinparam padding 20
skinparam dpi 150

skinparam rectangle {
    BackgroundColor #DCEEFF
    BorderColor #3973AC
    FontColor #16324F
    FontStyle bold
    FontSize 14
    RoundCorner 14
}

skinparam ArrowColor #526D82
skinparam ArrowFontColor #263746
skinparam ArrowFontSize 12

' Top
rectangle "Member" as Member
rectangle "ExecutiveCommitteeMember" as ExecutiveCommitteeMember

' Centre
rectangle "Activity" as Activity #72B6E8

' Bottom
rectangle "FinancialManagement" as FinancialManagement

' Layout constraints
Member -[hidden]right- ExecutiveCommitteeMember

Member -[hidden]down- Activity
ExecutiveCommitteeMember -[hidden]down- Activity

Activity -[hidden]down- FinancialManagement

' CRC collaborations
Member -down- Activity : Views activities, participation and\nattendance history

ExecutiveCommitteeMember -down- Activity : Creates or updates activities and\nrecords attendance

Activity -down- FinancialManagement : Links activities with related\nfinancial information

caption Fig crc.11: Activity
@enduml
