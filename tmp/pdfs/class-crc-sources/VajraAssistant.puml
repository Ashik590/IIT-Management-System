@startuml
title Ref: Table 27\nName: VajraAssistant

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 140
skinparam ranksep 150
skinparam padding 20
skinparam dpi 150

skinparam rectangle {
    BackgroundColor #DCEEFF
    BorderColor #3973AC
    FontColor #16324F
    FontStyle bold
    FontSize 14
    RoundCorner 14
}

skinparam ArrowColor #526D82
skinparam ArrowFontColor #263746
skinparam ArrowFontSize 12

' Top
rectangle "YogaContent" as YogaContent

' Centre
rectangle "VajraAssistant" as VajraAssistant #72B6E8

' Bottom
rectangle "Member" as Member
rectangle "YogaInstructor" as YogaInstructor

' Layout constraints
YogaContent -[hidden]down- VajraAssistant
Member -[hidden]right- YogaInstructor
VajraAssistant -[hidden]down- Member
VajraAssistant -[hidden]down- YogaInstructor

' CRC collaborations
YogaContent -down- VajraAssistant : Searches approved yoga content

VajraAssistant -down- Member : Answers questions and suggests\nrelevant material

VajraAssistant -down- YogaInstructor : Uses instructor-approved safety\nguidance

caption Fig crc.18: VajraAssistant
@enduml
