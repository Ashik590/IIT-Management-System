@startuml
title Ref: Table 13\nName: ExecutiveCommitteeMember

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 140
skinparam ranksep 150
skinparam padding 20
skinparam dpi 150

skinparam rectangle {
    BackgroundColor #DCEEFF
    BorderColor #3973AC
    FontColor #16324F
    FontStyle bold
    FontSize 14
    RoundCorner 14
}

skinparam ArrowColor #526D82
skinparam ArrowFontColor #263746
skinparam ArrowFontSize 12

' Top
rectangle "Member" as Member

' Middle
rectangle "Activity" as Activity
rectangle "ExecutiveCommitteeMember" as ExecutiveCommitteeMember #72B6E8
rectangle "FinancialManagement" as FinancialManagement

' Bottom
rectangle "MediaPost" as MediaPost

' Layout constraints
Activity -[hidden]right- ExecutiveCommitteeMember
ExecutiveCommitteeMember -[hidden]right- FinancialManagement

Member -[hidden]down- ExecutiveCommitteeMember
Activity -[hidden]down- MediaPost

' CRC collaborations
Member -down- ExecutiveCommitteeMember : Views applications, verifies information\nor dismisses incorrect applications

Activity -right- ExecutiveCommitteeMember : Creates or updates activities and\nrecords attendance

ExecutiveCommitteeMember -right- FinancialManagement : Accesses committee-related\nfinancial information

MediaPost -up- ExecutiveCommitteeMember : Accesses committee-related notices\nand activity media

caption Fig crc.4: ExecutiveCommitteeMember
@enduml
